{
  "name": "lemon-bluu",
  "private": true,
  "workspaces": [
    "apps/*",
    "apps/bots/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "turbo run build --filter=@lemon-bluu/web",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "prepare": "husky",
    "mtg-glicko": "yarn workspace @lemon-bluu/mtg-glicko start",
    "isfl-draft-order": "yarn workspace @lemon-bluu/isfl-draft-order start"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "latest",
    "turbo": "2.9.14"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=18"
  },
  "resolutions": {
    "tar": ">=7.5.7",
    "undici": ">=6.23.0 <7.0.0"
  },
  "lint-staged": {
    "apps/bots/takoyaki/src/**/*.ts": "eslint --fix",
    "apps/bots/kaiju-keeper/src/**/*.ts": "eslint --fix",
    "apps/bots/fetcher-bee/src/**/*.ts": "eslint --fix",
    "apps/bots/pakka-finder/src/**/*.ts": "eslint --fix",
    "apps/bots/bot-template/src/**/*.ts": "eslint --fix",
    "packages/discord/src/**/*.ts": "eslint --fix",
    "packages/ui/src/**/*.{ts,tsx}": "eslint --fix",
    "apps/web/**/*.{ts,tsx}": "eslint --config apps/web/eslint.config.mjs --fix",
    "tools/pbe-scraper/src/**/*.ts": "eslint --config tools/pbe-scraper/eslint.config.js --fix",
    "tools/pbe-portal-scraper/src/**/*.ts": "eslint --config tools/pbe-portal-scraper/eslint.config.js --fix",
    "tools/mtg-glicko/src/**/*.ts": "eslint --config tools/mtg-glicko/eslint.config.js --fix",
    "tools/isfl-draft-order/src/**/*.ts": "eslint --config tools/isfl-draft-order/eslint.config.js --fix"
  }
}
