# Discord Bot Tokens
TOKEN=your_production_bot_token_here
CLIENT_ID=your_production_client_id_here

# Development Bot Tokens (optional - use a separate test bot)
DEV_TOKEN=your_development_bot_token_here
DEV_CLIENT_ID=your_development_client_id_here

# Environment
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/pakka_tracker

# EloShowdown API key (optional; raises the request rate limit above anonymous)
ELOSHOWDOWN_API_KEY=
