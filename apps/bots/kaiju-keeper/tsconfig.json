{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Node16",
    "outDir": "./build",
    "strict": true,
    "allowJs": false,
    "moduleResolution": "node16",
    "importHelpers": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "removeComments": true,
    "typeRoots": [
      "node_modules/@types",
      "../../../node_modules/@types",
      "./typings"
    ],
    "isolatedModules": true,
    "types": ["node", "jest"],
    "sourceMap": false,
    "rootDir": "./src",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "src/*": ["./src/*"],
      "*": ["./*"]
    }
  },

  "include": ["./*.ts", "./src", "./typings"],
  "exclude": ["node_modules", "build"]
}
