{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ESNext", "DOM"],
    "outDir": "./build",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "rootDir": "./src",
    "baseUrl": ".",
    "types": ["node"],
    "moduleResolution": "node"
  },
  "exclude": ["node_modules", "build"],
  "include": ["src/**/*"]
}
